#!/bin/bash

if [ "$EUID" -eq 0 ]; then
	echo "Please don't run me as root using sudo. I will prompt you." >&2
	exit 1
fi

if [ ! "$1" = "powersave" ] && [ ! "$1" = "schedutil" ] ; then
	echo "Usage: $0 [powersave|schedutil]"
	exit 1
fi

TEMPLATE=conf/template.conf
DEST=/etc/tlp.d/10-yoga.conf
PRESET="conf/$1.conf"

sudo cp "$TEMPLATE" "$DEST"
sudo sed -e '/#INCLUDE_DRIVER#/ {' -e "r $PRESET" -e 'd' -e '}' -i "$DEST"
sudo systemctl restart tlp

status=$?

if [ "$status" -ne 0 ]; then
	echo "Failed to start TLP."
	exit 1
fi
