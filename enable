#!/bin/bash

if [ "$EUID" -ne 0 ]; then
	echo "Not root. Abort." >&2
	exit 1
fi

if [ ! "$1" = "powersave" ] && [ ! "$1" = "schedutil" ] ; then
	echo "Usage: $0 [powersave|schedutil]"
	exit 1
fi

TEMPLATE=conf/template.conf
DEST=/etc/tlp.d/10-yoga.conf
PRESET="conf/$1.conf"

cat "$TEMPLATE" "$PRESET" > "$DEST"
systemctl restart tlp

status=$?

if [ "$status" -ne 0 ]; then
	echo "Failed to start TLP."
	exit 1
fi
